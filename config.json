{
  "name": "Data Opt-Out Tool",
  "namespace": "Nottingham\\DataOptOutTool",
  "description": "Removes rows from a CSV file for participants/patients who have opted out of data collection. Filtering happens entirely on the user's device.",
  "framework-version": 16,
  "authors": [
    {
      "name": "Richard Dooley",
      "email": "richard.dooley@nottingham.ac.uk",
      "institution": "University of Nottingham"
    },
    {
      "name": "Nicholas Russell",
      "institution": "University of Nottingham"
    }
  ],
  "project-settings": [
    {
      "key": "hdr-instruction-roles",
      "name": "<br><b>Instructions / User Access</b>",
      "type": "descriptive"
    },
    {
      "key": "instruction-text",
      "name": "Custom instruction text",
      "type": "textarea",
      "required": false
    },
    {
      "key": "instruction-style",
      "name": "Custom instruction style",
      "type": "radio",
      "choices": [ { "value": "", "name": "Information" }, { "value": "warn", "name": "Warning" } ],
      "required": false
    },
    {
      "key": "process-roles",
      "name": "Process Roles",
      "type": "user-role-list",
      "repeatable": true,
      "required": true
    },
    {
      "key": "hdr-record",
      "name": "<br><b>Record Selection</b><script>$('[field=\"process-roles\"] td:first').css('width','45%')</script>",
      "type": "descriptive"
    },
    {
      "key": "record-label-field",
      "name": "Record label field",
      "required": false,
      "type": "text"
    },
    {
      "key": "record-label-filter",
      "name": "Filter records by label field",
      "required": false,
      "type": "checkbox"
    },
    {
      "key": "hdr-field",
      "name": "<br><b>Field Selection</b>",
      "type": "descriptive"
    },
    {
      "key": "upload-target",
      "name": "Upload Target",
      "type": "sub_settings",
      "repeatable": false,
      "required": true,
      "sub_settings": [
        {
          "key": "upload-mode",
          "name": "Repeat type",
          "type": "radio",
          "required": true,
          "choices": [
            { "value": "classic-form",       "name": "Classic: repeating form" },
            { "value": "longitudinal-event", "name": "Longitudinal: repeating event" },
            { "value": "longitudinal-form",  "name": "Longitudinal: repeating form" }
          ]
        },

        {
          "key": "upload-event",
          "name": "Repeating event",
          "type": "text",
          "required": true,
          "branchingLogic": {
            "type": "or",
            "conditions": [
              { "field": "upload-mode", "value": "longitudinal-event" },
              { "field": "upload-mode", "value": "longitudinal-form" }
            ]
          }
        },
        {
          "key": "upload-form",
          "name": "Repeating form",
          "type": "form-list",
          "required": true,
          "branchingLogic": {
            "type": "or",
            "conditions": [
              { "field": "upload-mode", "value": "classic-form" },
              { "field": "upload-mode", "value": "longitudinal-form" }
            ]
          }
        },
        {
          "key": "upload-field",
          "name": "Field",
          "type": "field-list",
          "field-type": "file",
          "required": true,
          "branchingLogic": {
            "type": "or",
            "conditions": [
              { "field": "upload-mode", "value": "classic-form" },
              { "field": "upload-mode", "value": "longitudinal-event" },
              { "field": "upload-mode", "value": "longitudinal-form" }
            ]
          }
        }
      ]
    }
  ],
  "links": {
    "project": [
      {
        "name": "Process Opt-Outs",
        "icon": "fas fa-filter",
        "url": "process.php",
        "show-header-and-footer": true
      }
    ]
  },
  "auth-ajax-actions": ["upload-file", "get-records"]
}
